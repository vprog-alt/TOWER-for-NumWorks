UNPACK()
x,y,a,b,jump,jumps,dash,m_dash,kill,deaths,points,objets=spawn[0],spawn[1],0,0,False,False,0,0,0,0,0,[0 for i in range(len(levels))]
chrono=monotonic()
background(bg)

INIT()

f,m=0,0

while True:
  SETLEVEL(),PLAYER(),KEYOTHERS(),WARP()
  sleep(S)
  f+=1
  if monotonic()>m:
    m=monotonic()+1
    draw("{}fps".format(f),0,0,(255,255,255),(0,0,0))
    f=0
